# Example secrets configuration file
# Copy this file to ~/.config/lawsuit-parser/secrets.toml and fill in your actual credentials
#
# NOTE: This project shares the same database as hidden-danger project.
# If you already have ~/.config/hidden-danger/secrets.toml, you can copy it:
#   cp ~/.config/hidden-danger/secrets.toml ~/.config/lawsuit-parser/secrets.toml

# Database credentials for Cloud SQL PostgreSQL
# Used together with config/database.toml for connection parameters
[database]
user = "research"
password = "your_database_password_here"

# API credentials for LLM providers (used by scripts/zero_shot_classifier.py).
# Env vars of the same purpose, if set, take precedence over these.
[api]
# Anthropic (Claude) - set exactly one. A console API key goes in
# anthropic_api_key. A `claude setup-token` bearer token goes in
# anthropic_auth_token; the classifier sends the Claude Code identity
# system prompt alongside it (Anthropic 429s these tokens otherwise).
# anthropic_api_key = "sk-ant-api03-..."
# anthropic_auth_token = "sk-ant-oat01-..."
#
# Gemini needs no key here - it authenticates via Vertex AI with
# Application Default Credentials (`gcloud auth application-default login`).

# Other sensitive configuration
# Add any other secrets your project needs here
